{
  "name": "time-adventure",
  "version": "1.13.8",
  "private": true,
  "type": "module",
  "description": "A local-first iPad planning app for children aged 11 to 12.",
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "dev:ipad": "python3 -m http.server 4173 --bind 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build:pages && wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
