{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "time-adventure",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "app.rackhub.ltd",
      "custom_domain": true
    }
  ]
}
